        "posee": [
          "coche1",
          "coche2"
        ]
      }
    },
    {
      "nombre": "factura1",
      "clase": "Factura",
      "propiedades": {
        "fechaArreglo": "2022-01-01T00:00:00.000Z",
        "facturaDe": "juan",
        "facturaPara": "maria"
      }
    },
    {
      "nombre": "factura2",
      "clase": "Factura",
      "propiedades": {
        "fechaArreglo": "2022-01-02T00:00:00.000Z",
        "facturaDe": "pedro",
        "facturaPara": "maria"
      }
    }
  ]
}